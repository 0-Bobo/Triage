# Normalise line endings to LF in the repo; check out LF on every platform.
* text=auto eol=lf

*.py     text eol=lf
*.pyi    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.html   text eol=lf
*.zsh    text eol=lf
*.sh     text eol=lf
Makefile text eol=lf
.editorconfig text eol=lf

# Binaries — never touch.
*.png binary
*.jpg binary
*.ico binary
*.whl binary
samples/** binary
samples/src/** text diff eol=lf
